
def selection_sort(a):
    comparisons = swaps = 0
    n = len(a)

    for i in range(n - 1):
        minimum = i
        for j in range(i + 1, n):
            comparisons += 1
            if a[j] < a[minimum]:
                minimum = j

        if minimum != i:
            a[i], a[minimum] = a[minimum], a[i]
            swaps += 1

    return comparisons, swaps


def bubble_sort(a):
    comparisons = swaps = 0
    n = len(a)

    for i in range(n - 1):
        for j in range(n - i - 1):
            comparisons += 1
            if a[j] > a[j + 1]:
                a[j], a[j + 1] = a[j + 1], a[j]
                swaps += 1

    return comparisons, swaps


def insertion_sort(a):
    comparisons = movements = 0

    for i in range(1, len(a)):
        key = a[i]
        j = i - 1

        while j >= 0:
            comparisons += 1
            if a[j] > key:
                a[j + 1] = a[j]
                movements += 1
                j -= 1
            else:
                break

        a[j + 1] = key
        movements += 1

    return comparisons, movements


arr = list(map(int, input("Enter elements: ").split()))

a = arr.copy()
b = arr.copy()
c = arr.copy()

x, y = selection_sort(a)
p, q = bubble_sort(b)
r, s = insertion_sort(c)

print("\nSelection Sort:", a)
print("Comparisons:", x, "Swaps:", y)

print("\nBubble Sort:", b)
print("Comparisons:", p, "Swaps:", q)

print("\nInsertion Sort:", c)
print("Comparisons:", r, "Movements:", s)
